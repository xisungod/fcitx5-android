--- /dev/null
+++ b/app/src/test/java/org/fcitx/fcitx5/android/OfflineVoiceEngineTest.kt
@@ -0,0 +1,300 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android
+
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Availability
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Failure
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Phase
+import org.junit.Assert.*
+import org.junit.Test
+
+class OfflineVoiceEngineTest {
+    private class Clock : OfflineVoiceEngine.Scheduler {
+        private data class Task(val due: Long, val action: () -> Unit, var cancelled: Boolean = false)
+        private var now = 0L
+        private val tasks = mutableListOf<Task>()
+        override fun after(delayMs: Long, action: () -> Unit): OfflineVoiceEngine.Cancellation {
+            val task = Task(now + delayMs, action)
+            tasks += task
+            return OfflineVoiceEngine.Cancellation { task.cancelled = true }
+        }
+        fun advance(ms: Long) {
+            val target = now + ms
+            while (true) {
+                val next = tasks.filter { !it.cancelled && it.due <= target }.minByOrNull { it.due } ?: break
+                tasks.remove(next)
+                now = next.due
+                next.action()
+            }
+            now = target
+        }
+    }
+
+    private class Backend(val listener: OfflineVoiceEngine.Listener) : OfflineVoiceEngine.Backend {
+        var support: ((Failure?) -> Unit)? = null
+        var starts = 0
+        var stops = 0
+        var cancels = 0
+        var destroys = 0
+        var startError: RuntimeException? = null
+        var stopError: RuntimeException? = null
+        var callbackOnCancel = false
+        override fun checkSupport(callback: (Failure?) -> Unit) { support = callback }
+        override fun start() { starts++; startError?.let { throw it } }
+        override fun stop() { stops++; stopError?.let { throw it } }
+        override fun cancel() {
+            cancels++
+            if (callbackOnCancel) listener.onFinal("cancelled service result")
+        }
+        override fun destroy() { destroys++ }
+    }
+
+    private class Factory : OfflineVoiceEngine.BackendFactory {
+        var available = Availability.Available
+        var createError: RuntimeException? = null
+        val instances = mutableListOf<Backend>()
+        override fun availability() = available
+        override fun create(listener: OfflineVoiceEngine.Listener): OfflineVoiceEngine.Backend {
+            createError?.let { throw it }
+            return Backend(listener).also(instances::add)
+        }
+    }
+
+    private class Harness {
+        val factory = Factory()
+        val clock = Clock()
+        val states = mutableListOf<OfflineVoiceEngine.State>()
+        val engine = OfflineVoiceEngine(factory, clock, states::add)
+        val backend get() = factory.instances.last()
+        fun startListening() {
+            engine.start()
+            backend.support!!(null)
+            backend.listener.onReady()
+        }
+    }
+
+    @Test fun partialsAreOnlyPreviewAndFinalMustBeExplicitlyAcceptedOnce() {
+        val h = Harness()
+        h.startListening()
+        h.backend.listener.onPartial("今天")
+        assertEquals(Phase.Listening, h.engine.state.phase)
+        assertEquals("今天", h.engine.state.text)
+        assertNull(h.engine.consumeFinal())
+        h.backend.listener.onPartial("今天天气")
+        h.backend.listener.onFinal("今天天气很好。")
+        assertEquals(Phase.Ready, h.engine.state.phase)
+        assertEquals("今天天气很好。", h.engine.state.text)
+        assertEquals(1, h.backend.destroys)
+        h.backend.listener.onFinal("duplicate result")
+        h.backend.listener.onPartial("late partial")
+        h.backend.listener.onError(Failure.ServiceError)
+        assertEquals("今天天气很好。", h.engine.consumeFinal())
+        assertNull(h.engine.consumeFinal())
+        assertEquals(Phase.Idle, h.engine.state.phase)
+        assertEquals(1, h.states.count { it.phase == Phase.Ready })
+    }
+
+    @Test fun installedModelCheckPrecedesRecordingAndPrematureResultsAreIgnored() {
+        val h = Harness()
+        h.engine.start()
+        h.backend.listener.onFinal("before start")
+        h.backend.listener.onPartial("before start")
+        assertEquals(Phase.Checking, h.engine.state.phase)
+        assertEquals(0, h.backend.starts)
+        assertNull(h.engine.consumeFinal())
+        h.backend.support!!(null)
+        h.backend.support!!(null)
+        assertEquals(1, h.backend.starts)
+    }
+
+    @Test fun missingInstalledModelFailsWithoutStartingOrRetrying() {
+        val h = Harness()
+        h.engine.start()
+        h.backend.support!!(Failure.LanguageUnavailable)
+        assertEquals(Failure.LanguageUnavailable, h.engine.state.failure)
+        assertEquals(0, h.backend.starts)
+        assertEquals(1, h.backend.destroys)
+        h.backend.support!!(null)
+        assertEquals(0, h.backend.starts)
+        assertEquals(1, h.factory.instances.size)
+    }
+
+    @Test fun absentOnDeviceServiceNeverCreatesARecognizer() {
+        for (availability in listOf(Availability.AndroidTooOld, Availability.NoOnDeviceService)) {
+            val h = Harness()
+            h.factory.available = availability
+            h.engine.start()
+            assertEquals(Failure.Unavailable, h.engine.state.failure)
+            assertTrue(h.factory.instances.isEmpty())
+        }
+    }
+
+    @Test fun cancellationInvalidatesPendingSupportAndEveryLateResult() {
+        val h = Harness()
+        h.engine.start()
+        val old = h.backend
+        h.engine.cancel()
+        old.support!!(null)
+        old.listener.onReady()
+        old.listener.onPartial("late")
+        old.listener.onFinal("late")
+        old.listener.onError(Failure.NoSpeech)
+        assertEquals(Phase.Idle, h.engine.state.phase)
+        assertEquals(0, old.starts)
+        assertEquals(1, old.cancels)
+        assertEquals(1, old.destroys)
+        assertNull(h.engine.consumeFinal())
+    }
+
+    @Test fun replacedSessionCannotWriteIntoTheNewSession() {
+        val h = Harness()
+        h.startListening()
+        val old = h.backend
+        old.callbackOnCancel = true
+        h.startListening()
+        h.backend.listener.onPartial("new preview")
+        old.listener.onFinal("old final")
+        old.listener.onError(Failure.NoSpeech)
+        assertEquals("new preview", h.engine.state.text)
+        assertEquals(Phase.Listening, h.engine.state.phase)
+        assertEquals(1, old.destroys)
+        assertEquals(0, h.states.count { it.phase == Phase.Ready })
+    }
+
+    @Test fun stopRequestsFinalOnlyOnceAndNeverAcceptsAPartial() {
+        val h = Harness()
+        h.startListening()
+        h.backend.listener.onPartial("还没完成")
+        h.engine.stop()
+        h.engine.stop()
+        h.backend.listener.onEnd()
+        assertEquals(1, h.backend.stops)
+        assertEquals(Phase.Processing, h.engine.state.phase)
+        assertNull(h.engine.consumeFinal())
+        h.backend.listener.onFinal("已经完成")
+        assertEquals("已经完成", h.engine.consumeFinal())
+    }
+
+    @Test fun stoppingDuringModelCheckCancelsWithoutStartingAudio() {
+        val h = Harness()
+        h.engine.start()
+        h.engine.stop()
+        h.backend.support!!(null)
+        assertEquals(Phase.Idle, h.engine.state.phase)
+        assertEquals(0, h.backend.starts)
+        assertEquals(0, h.backend.stops)
+        assertEquals(1, h.backend.destroys)
+    }
+
+    @Test fun errorsClearPreviewAndReleaseServiceWithoutFallback() {
+        for (failure in Failure.entries) {
+            val h = Harness()
+            h.startListening()
+            h.backend.listener.onPartial("未确认内容")
+            h.backend.listener.onError(failure)
+            assertEquals(Phase.Failed, h.engine.state.phase)
+            assertEquals(failure, h.engine.state.failure)
+            assertEquals("", h.engine.state.text)
+            assertNull(h.engine.consumeFinal())
+            assertEquals(1, h.factory.instances.size)
+            assertEquals(1, h.backend.destroys)
+        }
+    }
+
+    @Test fun supportStartupAndFinalResultTimeoutsReleaseTheirSessions() {
+        val checking = Harness()
+        checking.engine.start()
+        checking.clock.advance(OfflineVoiceEngine.SUPPORT_TIMEOUT_MS)
+        assertEquals(Failure.Timeout, checking.engine.state.failure)
+        assertEquals(0, checking.backend.starts)
+        assertEquals(1, checking.backend.destroys)
+
+        val starting = Harness()
+        starting.engine.start()
+        starting.backend.support!!(null)
+        starting.clock.advance(OfflineVoiceEngine.START_TIMEOUT_MS)
+        assertEquals(Failure.Timeout, starting.engine.state.failure)
+        assertEquals(1, starting.backend.destroys)
+
+        val waiting = Harness()
+        waiting.startListening()
+        waiting.engine.stop()
+        waiting.clock.advance(OfflineVoiceEngine.FINAL_RESULT_TIMEOUT_MS - 1)
+        waiting.backend.listener.onEnd() // a second end must not extend the deadline
+        waiting.clock.advance(1)
+        assertEquals(Failure.Timeout, waiting.engine.state.failure)
+        assertEquals(1, waiting.backend.destroys)
+        waiting.backend.listener.onFinal("too late")
+        assertNull(waiting.engine.consumeFinal())
+    }
+
+    @Test fun repeatedReadyAndPartialCallbacksCannotKeepTheMicrophoneOpenForever() {
+        val h = Harness()
+        h.startListening()
+        h.clock.advance(OfflineVoiceEngine.MAX_LISTEN_MS - 1)
+        h.backend.listener.onReady()
+        h.backend.listener.onPartial("仍在说话")
+        h.clock.advance(1)
+        assertEquals(Failure.Timeout, h.engine.state.failure)
+        assertEquals(1, h.backend.destroys)
+    }
+
+    @Test fun successfulFinalCancelsAllTimeoutsWhileAwaitingUserConfirmation() {
+        val h = Harness()
+        h.startListening()
+        h.backend.listener.onFinal("等待用户确认")
+        h.clock.advance(120_000L)
+        assertEquals(Phase.Ready, h.engine.state.phase)
+        assertEquals("等待用户确认", h.engine.consumeFinal())
+    }
+
+    @Test fun blankFinalDoesNotPromoteEarlierPartialText() {
+        val h = Harness()
+        h.startListening()
+        h.backend.listener.onPartial("partial only")
+        h.backend.listener.onFinal("  ")
+        assertEquals(Failure.NoSpeech, h.engine.state.failure)
+        assertNull(h.engine.consumeFinal())
+    }
+
+    @Test fun permissionAndServiceExceptionsFailClosedAndReleaseCreatedBackends() {
+        val h = Harness()
+        h.engine.start()
+        h.backend.startError = SecurityException("denied")
+        h.backend.support!!(null)
+        assertEquals(Failure.PermissionDenied, h.engine.state.failure)
+        assertEquals(1, h.backend.destroys)
+
+        val stopping = Harness()
+        stopping.startListening()
+        stopping.backend.stopError = IllegalStateException("dead service")
+        stopping.engine.stop()
+        assertEquals(Failure.ServiceError, stopping.engine.state.failure)
+        assertEquals(1, stopping.backend.destroys)
+
+        val creating = Harness()
+        creating.factory.createError = IllegalStateException("no service")
+        creating.engine.start()
+        assertEquals(Failure.ServiceError, creating.engine.state.failure)
+        assertTrue(creating.factory.instances.isEmpty())
+    }
+
+    @Test fun disposalIsFinalAndDropsCallbacksTimersAndPendingResult() {
+        val h = Harness()
+        h.startListening()
+        h.backend.callbackOnCancel = true
+        h.engine.destroy()
+        h.engine.destroy()
+        h.engine.start()
+        h.engine.stop()
+        h.engine.cancel()
+        h.backend.listener.onFinal("after disposal")
+        h.backend.listener.onPartial("after disposal")
+        h.backend.listener.onError(Failure.NoSpeech)
+        h.clock.advance(120_000L)
+        assertEquals(Phase.Disposed, h.engine.state.phase)
+        assertNull(h.engine.consumeFinal())
+        assertEquals(1, h.backend.destroys)
+        assertEquals(1, h.factory.instances.size)
+    }
+}
diff --git a/app/src/test/java/org/fcitx/fcitx5/android/OfflineVoiceInputUiTest.kt b/app/src/test/java/org/fcitx/fcitx5/android/OfflineVoiceInputUiTest.kt
