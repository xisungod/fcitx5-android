+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.input.keyboard
+
+/** Fixed storage in chronological order: typing never allocates a new ripple. */
+internal class PressEffectTrail(capacity: Int) {
+    class Ripple {
+        var x = 0f
+        var y = 0f
+        var flashWidth = 0f
+        var flashHeight = 0f
+        var keyFill = false
+        var keyId = -1
+        var colorIndex = 0
+        var shape = 0
+        var echoShape = 0
+        var rotation = 0f
+        var spin = 0f
+        var size = 1f
+        var stretchX = 1f
+        var stretchY = 1f
+        var driftX = 0f
+        var driftY = 0f
+        var start = 0L
+    }
+
+    init { require(capacity > 0) }
+    private val slots = Array(capacity) { Ripple() }
+    private var head = 0
+    var size = 0
+        private set
+
+    operator fun get(index: Int): Ripple {
+        require(index in 0 until size)
+        return slots[(head + index) % slots.size]
+    }
+
+    fun obtain(now: Long): Ripple {
+        val slot = (head + size) % slots.size
+        if (size == slots.size) head = (head + 1) % slots.size else size++
+        return slots[slot].also { it.start = now }
+    }
+
+    fun expire(now: Long, duration: Long) {
+        while (size > 0 && now - slots[head].start >= duration) {
+            head = (head + 1) % slots.size
+            size--
+        }
+    }
+
+    fun clear() {
+        head = 0
+        size = 0
+    }
+}
