diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/voice/AndroidOfflineVoiceBackend.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/voice/AndroidOfflineVoiceBackend.kt
new file mode 100644
index 0000000..18fc04b
--- /dev/null
+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/voice/AndroidOfflineVoiceBackend.kt
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android.input.voice
+
+import android.annotation.TargetApi
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Bundle
+import android.os.Handler
+import android.os.Looper
+import android.speech.RecognitionListener
+import android.speech.RecognitionSupport
+import android.speech.RecognitionSupportCallback
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import java.util.Locale
+import java.util.concurrent.Executor
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Availability
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Failure
+
+/** Uses only Android's explicit on-device service; never falls back or downloads a model. */
+@TargetApi(31)
+internal class AndroidOfflineVoiceBackend(
+    context: Context,
+    private val listener: OfflineVoiceEngine.Listener
+) : OfflineVoiceEngine.Backend {
+    private val recognizer = SpeechRecognizer.createOnDeviceSpeechRecognizer(context)
+    private val handler = Handler(Looper.getMainLooper())
+    private var disposed = false
+    private val request = recognitionRequest()
+
+    init {
+        recognizer.setRecognitionListener(object : RecognitionListener {
+            override fun onReadyForSpeech(params: Bundle?) { if (!disposed) listener.onReady() }
+            override fun onBeginningOfSpeech() {}
+            override fun onRmsChanged(rmsdB: Float) {}
+            override fun onBufferReceived(buffer: ByteArray?) {}
+            override fun onEndOfSpeech() { if (!disposed) listener.onEnd() }
+            override fun onError(error: Int) { if (!disposed) listener.onError(failureFor(error)) }
+            override fun onResults(results: Bundle?) {
+                if (!disposed) listener.onFinal(firstResult(results))
+            }
+            override fun onPartialResults(partialResults: Bundle?) {
+                if (!disposed) listener.onPartial(firstResult(partialResults))
+            }
+            override fun onEvent(eventType: Int, params: Bundle?) {}
+        })
+    }
+
+    override fun checkSupport(callback: (Failure?) -> Unit) {
+        if (disposed) return
+        if (Build.VERSION.SDK_INT >= 33) checkInstalledModel(callback)
+        else callback(null) // API 31/32 have no support query; only the on-device start is tried.
+    }
+
+    @TargetApi(33)
+    private fun checkInstalledModel(callback: (Failure?) -> Unit) {
+        recognizer.checkRecognitionSupport(request, Executor { task -> handler.post(task) },
+            object : RecognitionSupportCallback {
+                override fun onSupportResult(recognitionSupport: RecognitionSupport) {
+                    if (disposed) return
+                    // Online, pending and downloadable lists deliberately confer no permission.
+                    callback(if (hasInstalledChineseModel(recognitionSupport.installedOnDeviceLanguages))
+                        null else Failure.LanguageUnavailable)
+                }
+
+                override fun onError(error: Int) {
+                    if (!disposed) callback(failureFor(error))
+                }
+            })
+    }
+
+    override fun start() { if (!disposed) recognizer.startListening(request) }
+    override fun stop() { if (!disposed) recognizer.stopListening() }
+    override fun cancel() { if (!disposed) recognizer.cancel() }
+    override fun destroy() {
+        if (disposed) return
+        disposed = true
+        recognizer.destroy()
+    }
+
+    class Factory(context: Context) : OfflineVoiceEngine.BackendFactory {
+        private val context = context.applicationContext
+        override fun availability() = availability(context)
+        override fun create(listener: OfflineVoiceEngine.Listener): OfflineVoiceEngine.Backend {
+            check(availability() == Availability.Available)
+            return AndroidOfflineVoiceBackend(context, listener)
+        }
+    }
+
+    companion object {
+        fun availability(context: Context): Availability {
+            if (Build.VERSION.SDK_INT < 31) return Availability.AndroidTooOld
+            return try {
+                if (SpeechRecognizer.isOnDeviceRecognitionAvailable(context)) Availability.Available
+                else Availability.NoOnDeviceService
+            } catch (_: RuntimeException) {
+                Availability.NoOnDeviceService
+            }
+        }
+
+        fun hasInstalledChineseModel(installedLanguages: List<String>): Boolean = installedLanguages.any {
+            val locale = Locale.forLanguageTag(it.replace('_', '-'))
+            locale.language == "zh" && locale.country == "CN" &&
+                (locale.script.isEmpty() || locale.script == "Hans")
+        }
+
+        fun recognitionRequest(): Intent = Intent(RecognizerIntent.ACTION_RECOGNIZE_SPEECH).apply {
+            // This intent is a parameter for the on-device service, never an Activity fallback.
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL, RecognizerIntent.LANGUAGE_MODEL_FREE_FORM)
+            putExtra(RecognizerIntent.EXTRA_LANGUAGE, OfflineVoiceEngine.LANGUAGE)
+            putExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, true)
+            putExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 1)
+            putExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, true)
+        }
+
+        private fun firstResult(bundle: Bundle?): String = bundle
+            ?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION)
+            ?.firstOrNull { it.isNotBlank() }.orEmpty()
+
+        fun failureFor(error: Int): Failure = when (error) {
+            SpeechRecognizer.ERROR_INSUFFICIENT_PERMISSIONS -> Failure.PermissionDenied
+            SpeechRecognizer.ERROR_NO_MATCH, SpeechRecognizer.ERROR_SPEECH_TIMEOUT -> Failure.NoSpeech
+            SpeechRecognizer.ERROR_RECOGNIZER_BUSY, SpeechRecognizer.ERROR_TOO_MANY_REQUESTS -> Failure.Busy
+            SpeechRecognizer.ERROR_LANGUAGE_NOT_SUPPORTED, SpeechRecognizer.ERROR_LANGUAGE_UNAVAILABLE ->
+                Failure.LanguageUnavailable
+            SpeechRecognizer.ERROR_NETWORK, SpeechRecognizer.ERROR_NETWORK_TIMEOUT -> Failure.NetworkUnavailable
+            else -> Failure.ServiceError
+        }
+    }
+}
+
+internal class AndroidVoiceScheduler : OfflineVoiceEngine.Scheduler {
+    private val handler = Handler(Looper.getMainLooper())
+    override fun after(delayMs: Long, action: () -> Unit): OfflineVoiceEngine.Cancellation {
+        val task = Runnable(action)
+        handler.postDelayed(task, delayMs)
+        return OfflineVoiceEngine.Cancellation { handler.removeCallbacks(task) }
+    }
+}
