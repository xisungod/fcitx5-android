+                val value = maxOf(Color.red(pixel), Color.green(pixel), Color.blue(pixel))
+                if (value <= 2) continue
+                energy += value
+                weighted += value * kotlin.math.hypot((x - 300).toDouble(), (y - 100).toDouble())
+            }
+            return weighted / energy
+        }
+        fun renderCase(expansion: Int): Pair<Bitmap, Bitmap> {
