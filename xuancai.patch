+    /** Keep legacy preset choices visible without silently replacing them when this page opens. */
+    private fun randomPaletteColors(): IntArray = when (prefs.pressEffectPalette.getValue()) {
+        ThemePrefs.PressEffectPalette.SamsungCool -> PressEffect.SAMSUNG_COOL
+        ThemePrefs.PressEffectPalette.Cyberpunk -> PressEffect.CYBERPUNK
+        ThemePrefs.PressEffectPalette.Cool -> PressEffect.COOL
+        ThemePrefs.PressEffectPalette.Rainbow -> PressEffect.RAINBOW
+        ThemePrefs.PressEffectPalette.Berry -> PressEffect.BERRY
+        ThemePrefs.PressEffectPalette.Accent -> intArrayOf(
+            (runCatching { ThemeManager.activeTheme }.getOrDefault(ThemeManager.DefaultTheme))
+                .accentKeyBackgroundColor.takeIf { it ushr 24 != 0 } ?: 0xFF76B5FF.toInt()
+        )
+        ThemePrefs.PressEffectPalette.Custom -> listOf(
+            prefs.pressCustomColor1, prefs.pressCustomColor2, prefs.pressCustomColor3, prefs.pressCustomColor4
+        ).take(prefs.pressCustomColorCount.getValue().coerceIn(1, 4))
+            .map { it.getValue().argb }.toIntArray()
+    }
+
+    private fun colorButton(color: Int, buttonTag: String, action: () -> Unit) = Button(context).apply {
+        tag = buttonTag
+        text = EffectColorEditor.hexFor(color)
+        textSize = 12f
+        isAllCaps = false
