+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.input.keyboard
+
+import android.animation.ValueAnimator
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.RadialGradient
+import android.graphics.Shader
+import android.os.Build
+import android.os.SystemClock
+import android.view.View
+import org.fcitx.fcitx5.android.data.prefs.AppPrefs
+import kotlin.math.PI
+import kotlin.math.atan2
+import kotlin.math.cos
+import kotlin.math.exp
+import kotlin.math.floor
+import kotlin.math.hypot
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.pow
+import kotlin.random.Random
+
+/**
+ * Colourful key press effect in the spirit of Samsung Keys Cafe "keyboard colour effects":
+ * every press releases a soft, feathered water ripple of a random palette colour
+ * with a random irregular shape, which spreads over the neighbouring keys and fades out.
+ *
+ * It is drawn by the keyboard itself: [drawUnder] before the keys (light leaks through the
+ * gaps and translucent keys, labels stay crisp) and [drawOver] after them with reduced
+ * strength so the colour also washes over the key caps.
+ *
+ * Textures are generated procedurally once per process on a background thread, as white
+ * alpha masks, and tinted per ripple, so any number of colours costs no extra memory.
+ */
+internal class PressEffect(
+    private val host: View,
+    palette: IntArray,
+    isDark: Boolean,
+    sizePercent: Int,
+    expansionTimeMs: Int,
+    fadeOutTimeMs: Int,
+    overKeysPercent: Int,
+    private val pressEnabled: Boolean,
+    private val idleEnabled: Boolean,
+    private val breathing: IdleBreathing,
+    idleColors: IntArray
+) {
+
+    private val colors: IntArray =
+        (if (palette.isEmpty()) CYBERPUNK else palette).map { adapt(it, isDark) }.toIntArray()
+
+    private val density = host.resources.displayMetrics.density
+    private val maxRadius = BASE_RADIUS_DP * density * sizePercent.coerceIn(20, 400) / 100f
+    private val flashRadius = FLASH_RADIUS_DP * density
+    private val expansionDuration = expansionTimeMs.coerceIn(100, 2000).toLong()
+    private val duration = expansionDuration + fadeOutTimeMs.coerceIn(100, 2000)
+    private val underStrength = if (isDark) 1f else 0.9f
+    private val overStrength = overKeysPercent.coerceIn(0, 100) / 100f * (if (isDark) 1f else 0.8f)
+
+    private val random = Random(SystemClock.uptimeMillis())
+    private val ripples = PressEffectTrail(MAX_RIPPLES)
+    private val styles = Array(colors.size) { RipplePaints(colors[it]) }
+    private var lastColorIndex = -1
+    private var frameTime = 0L
+    private var active = false
+    private val idleStyles = Array(2) { i ->
+        RipplePaints(idleColors.getOrElse(i) { CYBERPUNK[i] })
+    }
+    private val disableAnimation by AppPrefs.getInstance().advanced.disableAnimation
+    private val frameCallback = Runnable {
+        if (canDraw()) host.invalidate()
+    }
+
+    private fun canDraw() = active && host.isAttachedToWindow && host.isShown &&
+        host.windowVisibility == View.VISIBLE
+
+    fun setActive(value: Boolean) {
+        active = value
+        syncVisibility()
+    }
+
+    fun syncVisibility() {
+        host.removeCallbacks(frameCallback)
+        if (!canDraw() || !animatorsEnabled()) {
+            ripples.clear()
+            breathing.stop()
+        } else if (idleEnabled && !breathing.running) {
+            breathing.resume(SystemClock.uptimeMillis())
+        }
+        host.invalidate()
+    }
+
+    fun onRelease() {
+        if (!canDraw()) return
+        breathing.activity(SystemClock.uptimeMillis(), held = false)
+        host.removeCallbacks(frameCallback)
+        host.postInvalidateOnAnimation()
+    }
+
+    private fun scheduleFrame(delay: Long) {
+        host.removeCallbacks(frameCallback)
+        if (!canDraw() || !animatorsEnabled()) return
+        if (delay == 0L) host.postOnAnimation(frameCallback)
+        else host.postOnAnimationDelayed(frameCallback, delay)
+    }
+
+    private class RipplePaints(color: Int) {
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG).apply {
+            colorFilter = PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN)
+        }
+        val flashPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG).apply {
+            colorFilter = PorterDuffColorFilter(mix(color, Color.WHITE, 0.12f), PorterDuff.Mode.SRC_IN)
+        }
+        // Immediate feedback even while the first set of textures is warming up.
+        val fallbackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            shader = RadialGradient(
+                0f, 0f, 1f,
+                intArrayOf(color, color and 0x00ffffff),
+                null, Shader.TileMode.CLAMP
+            )
+        }
+    }
+
+    init {
+        Textures.ensure()
+    }
+
+    fun onPress(pressX: Float, pressY: Float) {
+        if (!canDraw() || !animatorsEnabled()) return
+        val now = SystemClock.uptimeMillis()
+        if (idleEnabled && !breathing.running) breathing.resume(now)
+        breathing.activity(now, held = true)
+        host.removeCallbacks(frameCallback)
+        host.postInvalidateOnAnimation()
+        if (!pressEnabled) return
+        if (Textures.ready == null) Textures.ensure()
+        var index = random.nextInt(colors.size)
+        if (colors.size > 1 && index == lastColorIndex) {
+            index = (index + 1 + random.nextInt(colors.size - 1)) % colors.size
+        }
+        lastColorIndex = index
+        val shapes = PressEffectMasks.SHAPES
+        val selectedShape = random.nextInt(shapes)
+        ripples.expire(now, duration)
+        ripples.obtain(now).apply {
+            x = pressX
+            y = pressY
+            colorIndex = index
+            shape = selectedShape
+            echoShape = (selectedShape + 1 + random.nextInt(max(1, shapes - 1))) % shapes
+            rotation = random.nextFloat() * 360f
+            spin = (random.nextFloat() * 2f - 1f) * 24f
+            size = 0.88f + random.nextFloat() * 0.24f
+            stretchX = 0.82f + random.nextFloat() * 0.36f
+            stretchY = 0.82f + random.nextFloat() * 0.36f
+            driftX = (random.nextFloat() - 0.5f) * 22f * density
+            driftY = (random.nextFloat() - 0.5f) * 16f * density
+        }
+        host.postInvalidateOnAnimation()
+    }
+
+    /** Both light layers stay under the key legends. */
+    fun drawUnder(canvas: Canvas) {
+        frameTime = SystemClock.uptimeMillis()
+        if (!canDraw() || !animatorsEnabled()) {
+            clear()
+            return
+        }
+        ripples.expire(frameTime, duration)
+        val idleAlpha = if (idleEnabled) breathing.alpha(frameTime) else 0f
+        if (idleAlpha > 0.001f) drawBreathing(canvas, idleAlpha)
+        if (ripples.size > 0) draw(canvas, underStrength)
+    }
+
+    /** Fast frames for key presses, at most ~24 fps for slow idle breathing. */
+    fun drawOver(canvas: Canvas) {
+        if (!canDraw() || !animatorsEnabled()) return
+        if (ripples.size > 0) {
+            if (overStrength > 0f) draw(canvas, overStrength)
+            scheduleFrame(0L)
+        } else {
+            breathing.nextFrameDelay(frameTime)?.let(::scheduleFrame)
+        }
+    }
+
+    fun clear() {
+        host.removeCallbacks(frameCallback)
+        ripples.clear()
+        breathing.stop()
+    }
+
+    private fun drawBreathing(canvas: Canvas, alpha: Float) {
+        val phase = breathing.phase(frameTime)
+        val sizePulse = 0.92f + 0.08f * cos(2f * PI.toFloat() * phase)
+        val radius = max(host.width * 0.62f, host.height * 0.85f) * sizePulse
+        val textures = Textures.ready
+        for (i in idleStyles.indices) {
+            val x = host.width * if (i == 0) 0.28f else 0.76f
+            val y = host.height * if (i == 0) 0.66f else 0.40f
+            if (textures != null) {
+                drawTexture(canvas, textures.bodies[i * 4], x, y, radius,
+                    if (i == 0) -18f else 64f, idleStyles[i].paint, alpha)
+            } else {
+                val save = canvas.save()
+                canvas.translate(x, y)
+                canvas.scale(radius, radius)
+                idleStyles[i].fallbackPaint.alpha = (alpha * 255).toInt()
+                canvas.drawCircle(0f, 0f, 1f, idleStyles[i].fallbackPaint)
+                canvas.restoreToCount(save)
+            }
+        }
+    }
+
+    private fun draw(canvas: Canvas, strength: Float) {
+        val textures = Textures.ready
+        for (i in 0 until ripples.size) {
+            val r = ripples[i]
+            val style = styles[r.colorIndex]
+            val elapsed = (frameTime - r.start).coerceAtLeast(0L)
+            val t = elapsed.toFloat() / duration
+            if (t >= 1f) continue
+            val seconds = elapsed / 1000f
+            val angle = r.rotation + r.spin * seconds
+            val e = easeOut((elapsed.toFloat() / expansionDuration).coerceIn(0f, 1f))
+            val x = r.x + r.driftX * e
+            val y = r.y + r.driftY * e
+            if (textures == null) {
+                val save = canvas.save()
+                canvas.translate(x, y)
+                val radius = maxRadius * r.size * (0.16f + 0.84f * e)
+                canvas.scale(radius * r.stretchX, radius * r.stretchY)
+                style.fallbackPaint.alpha = (180f * strength * (1f - t)).toInt()
+                canvas.drawCircle(0f, 0f, 1f, style.fallbackPaint)
+                canvas.restoreToCount(save)
+                continue
+            }
+            // finger flash: a quick bright bloom right where the key was hit
+            if (t < FLASH_END) {
+                val k = t / FLASH_END
+                val alpha = 0.72f * (1f - k).pow(1.5f)
+                drawTexture(canvas, textures.dot, r.x, r.y, flashRadius * (1f + 0.7f * k), 0f, style.flashPaint, alpha * strength)
+            }
+            // main mist: spreads fast then slows down (ease-out), lingers, dissolves
+            val radius = maxRadius * r.size * (0.16f + 0.84f * e)
+            val bodyAlpha = 0.65f * ramp(elapsed.toFloat(), 0f, 35f) *
+                (1f - smoothstep(expansionDuration.toFloat(), duration.toFloat(), elapsed.toFloat()))
+            val save = canvas.save()
+            canvas.translate(x, y)
+            canvas.scale(r.stretchX, r.stretchY)
+            drawTexture(canvas, textures.bodies[r.shape], 0f, 0f, radius, angle, style.paint, bodyAlpha * strength)
+            // Only recent presses need the faint echo: bound GPU overdraw during fast typing.
+            val t2 = (t - ECHO_DELAY) / (1f - ECHO_DELAY)
+            if (t2 > 0f && i >= ripples.size - 3) {
+                val radius2 = maxRadius * r.size * (0.12f + 0.70f * easeOut(t2))
+                val echoAlpha = 0.18f * ramp(t2, 0f, 0.1f) * (1f - smoothstep(0.3f, 1f, t2))
+                drawTexture(canvas, textures.rings[r.echoShape], 0f, 0f, radius2, -angle * 0.6f, style.paint, echoAlpha * strength)
+            }
+            canvas.restoreToCount(save)
+        }
+    }
+
+    private fun drawTexture(
+        canvas: Canvas, bitmap: Bitmap, x: Float, y: Float, radius: Float,
+        angle: Float, paint: Paint, alpha: Float
+    ) {
+        if (alpha <= 0.004f || radius <= 0.5f) return
+        paint.alpha = (alpha.coerceIn(0f, 1f) * 255f).toInt()
+        val half = bitmap.width / 2f
+        val scale = radius / half
+        val save = canvas.save()
+        canvas.translate(x, y)
+        canvas.rotate(angle)
+        canvas.scale(scale, scale)
+        canvas.drawBitmap(bitmap, -half, -half, paint)
+        canvas.restoreToCount(save)
+    }
+
+    private fun animatorsEnabled(): Boolean =
+        !disableAnimation && (if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) ValueAnimator.areAnimatorsEnabled() else true)
+
+    /** white alpha masks: irregular water-ripple bodies, echo rings and a soft dot */
+    private class Textures(val bodies: Array<Bitmap>, val rings: Array<Bitmap>, val dot: Bitmap) {
+        companion object {
+            @Volatile
+            var ready: Textures? = null
+                private set
+
+            @Volatile
+            private var started = false
+
+            fun ensure() {
+                if (ready != null || started) return
+                synchronized(this) {
+                    if (ready != null || started) return
+                    started = true
+                }
+                Thread({
+                    try {
+                        val m = PressEffectMasks
+                        val noise = PressEffectMasks.Noise(20261003)
+                        val size = m.TEXTURE_SIZE
+                        val bodies = Array(m.SHAPES) { i -> bitmap(m.mist(noise, m.bodySeed(i), ring = false), size) }
+                        val rings = Array(m.SHAPES) { i -> bitmap(m.mist(noise, m.ringSeed(i), ring = true), size) }
+                        ready = Textures(bodies, rings, bitmap(m.dot(), m.DOT_SIZE))
+                    } catch (e: Exception) {
+                        started = false
+                    }
+                }, "PressEffectTextures").apply {
+                    isDaemon = true
+                    priority = Thread.NORM_PRIORITY - 1
+                }.start()
+            }
+
+            private fun bitmap(pixels: IntArray, size: Int): Bitmap =
+                Bitmap.createBitmap(pixels, size, size, Bitmap.Config.ARGB_8888).apply {
+                    prepareToDraw()
+                }
+        }
+    }
+
+    companion object {
+        private const val BASE_RADIUS_DP = 200f
+        private const val FLASH_RADIUS_DP = 19f
+        private const val FLASH_END = 0.22f
+        private const val ECHO_DELAY = 0.16f
+        private const val MAX_RIPPLES = 10
+
+        /** Ten neon tones: cyan/blue/violet/pink with acid yellow, green and mint accents. */
+        val CYBERPUNK = intArrayOf(
+            0xFF00F0FF.toInt(), 0xFF4DB8FF.toInt(), 0xFF386BFF.toInt(), 0xFF805BFF.toInt(),
+            0xFFBE38FF.toInt(), 0xFFFF2BD6.toInt(), 0xFFFF438E.toInt(), 0xFFE9FF48.toInt(),
+            0xFF76FF4D.toInt(), 0xFF00FFC6.toInt()
+        )
+
+        /** One UI blue, sky, aqua, light blue, cobalt, ice */
+        val COOL = intArrayOf(
+            0xFF3E91FF.toInt(), 0xFF00C2FF.toInt(), 0xFF2DE2C9.toInt(), 0xFF7FB7FF.toInt(),
+            0xFF5B6CFF.toInt(), 0xFFA8E6FF.toInt()
+        )
+
+        val RAINBOW = intArrayOf(
+            0xFFFF4D4D.toInt(), 0xFFFF9F1C.toInt(), 0xFFFFE14D.toInt(), 0xFF4DFF88.toInt(),
+            0xFF33D6FF.toInt(), 0xFF4D7CFF.toInt(), 0xFFB24DFF.toInt()
+        )
+
+        /** misty berry purple, the original skin's palette */
+        val BERRY = intArrayOf(
+            0xFF9F75FD.toInt(), 0xFFC08CFF.toInt(), 0xFFFF8AD8.toInt(), 0xFF7B6CFF.toInt(), 0xFFE0B3FF.toInt()
+        )
+
+        private fun easeOut(t: Float): Float = 1f - (1f - t.coerceIn(0f, 1f)).pow(3)
+
+        private fun ramp(t: Float, a: Float, b: Float): Float = ((t - a) / (b - a)).coerceIn(0f, 1f)
+
+        internal fun smoothstep(a: Float, b: Float, x: Float): Float {
+            val t = ((x - a) / (b - a)).coerceIn(0f, 1f)
+            return t * t * (3f - 2f * t)
+        }
+
+        private fun mix(a: Int, b: Int, k: Float): Int {
+            val r = Color.red(a) + ((Color.red(b) - Color.red(a)) * k).toInt()
+            val g = Color.green(a) + ((Color.green(b) - Color.green(a)) * k).toInt()
+            val bl = Color.blue(a) + ((Color.blue(b) - Color.blue(a)) * k).toInt()
+            return Color.rgb(r, g, bl)
+        }
+
+        /** on light keyboards neon pastels wash out: deepen them a little */
+        private fun adapt(color: Int, isDark: Boolean): Int {
+            if (isDark) return color or 0xFF000000.toInt()
+            val hsv = FloatArray(3)
+            Color.colorToHSV(color, hsv)
+            hsv[1] = min(1f, hsv[1] * 1.1f)
+            hsv[2] = hsv[2] * 0.86f
+            return Color.HSVToColor(hsv)
+        }
+    }
+}
+
+
+/**
+ * Pure pixel maths for [PressEffect]'s alpha masks (white, ARGB, non-premultiplied),
+ * kept free of Android types so it can be checked off-device.
+ */
+internal object PressEffectMasks {
+    const val SHAPES = 8
+    const val TEXTURE_SIZE = 256
+    const val DOT_SIZE = 64
+
+    fun bodySeed(i: Int) = 11 + i * 26
+    fun ringSeed(i: Int) = 7 + i * 31
+
+    fun mist(noise: Noise, seed: Int, ring: Boolean): IntArray {
+        val g = Random(seed)
+        // random lobes (2..5) make every ripple an irregular, water-like outline
+        val ks = intArrayOf(2, 3, 4, 5)
+        val amps = FloatArray(4) { (0.5f + g.nextFloat() * 0.5f) / ks[it].toFloat().pow(0.9f) }
+        val total = amps.sum()
+        val strength = 0.26f + g.nextFloat() * 0.12f
+        for (i in amps.indices) amps[i] = amps[i] / total * strength
+        val phases = FloatArray(4) { g.nextFloat() * 2f * PI.toFloat() }
+        var maxD = 0f
+        for (i in 0 until 360) {
+            val th = i / 360f * 2f * PI.toFloat()
+            maxD = max(maxD, lobes(th, ks, amps, phases))
+        }
+        val ox = g.nextFloat() * 50f
+        val oy = g.nextFloat() * 50f
+        val size = TEXTURE_SIZE
+        val c = (size - 1) / 2f
+        val pixels = IntArray(size * size)
+        for (py in 0 until size) {
+            for (px in 0 until size) {
+                val nx = (px - c) / (size / 2f)
+                val ny = (py - c) / (size / 2f)
+                val r0 = hypot(nx, ny)
+                if (r0 >= 0.995f) continue
+                // gentle domain warp: wispy, uneven edge
+                val wx = noise.fbm(nx * 1.4f + ox, ny * 1.4f + oy) - 0.5f
+                val wy = noise.fbm(nx * 1.4f + oy + 13f, ny * 1.4f + ox + 7f) - 0.5f
+                val x = nx + 0.10f * wx
+                val y = ny + 0.10f * wy
+                val r = hypot(x, y)
+                val th = atan2(y, x)
+                val rho = r / (lobes(th, ks, amps, phases) / maxD)
+                val cloud = (0.66f + 1.2f * (noise.fbm(x * 1.1f + oy, y * 1.1f + ox) - 0.5f)).coerceIn(0.3f, 1.15f)
+                val edge = 1f - PressEffect.smoothstep(0.84f, 0.99f, r0)
+                val a = if (ring) {
+                    val d = rho - 0.72f
+                    val w = if (d > 0f) 0.10f else 0.24f
+                    0.95f * exp(-(d / w) * (d / w))
+                } else {
+                    // A filled cloud with broad feathering; no bright hollow ring.
+                    val core = exp(-(rho / 0.58f).pow(2))
+                    val shoulder = 0.24f * exp(-((rho - 0.42f) / 0.30f).pow(2))
+                    (0.86f * core + shoulder) *
+                        (1f - PressEffect.smoothstep(0.63f, 1.03f, rho))
+                }
+                val alpha = (a * cloud * edge).coerceIn(0f, 1f)
+                pixels[py * size + px] = ((alpha * 255f + 0.5f).toInt() shl 24) or 0xFFFFFF
+            }
+        }
+        return pixels
+    }
+
+    fun dot(): IntArray {
+        val size = DOT_SIZE
+        val c = (size - 1) / 2f
+        val pixels = IntArray(size * size)
+        for (py in 0 until size) {
+            for (px in 0 until size) {
+                val r = hypot(px - c, py - c) / (size / 2f)
+                val a = exp(-(r / 0.48f).pow(2)) * (1f - PressEffect.smoothstep(0.85f, 0.99f, r))
+                pixels[py * size + px] = ((a.coerceIn(0f, 1f) * 255f + 0.5f).toInt() shl 24) or 0xFFFFFF
+            }
+        }
+        return pixels
+    }
+
+    private fun lobes(th: Float, ks: IntArray, amps: FloatArray, phases: FloatArray): Float {
+        var d = 1f
+        for (i in ks.indices) d += amps[i] * cos(ks[i] * th + phases[i])
+        return d
+    }
+
+    /** small tiling 2D value noise with a few octaves */
+    class Noise(seed: Int) {
+        private val grid = Random(seed).let { r -> FloatArray(GRID * GRID) { r.nextFloat() } }
+
+        private fun value(x: Float, y: Float): Float {
+            val xf = floor(x)
+            val yf = floor(y)
+            val ix = xf.toInt()
+            val iy = yf.toInt()
+            val fx = x - xf
+            val fy = y - yf
+            val sx = fx * fx * (3f - 2f * fx)
+            val sy = fy * fy * (3f - 2f * fy)
+            val top = at(ix, iy) + (at(ix + 1, iy) - at(ix, iy)) * sx
+            val bottom = at(ix, iy + 1) + (at(ix + 1, iy + 1) - at(ix, iy + 1)) * sx
+            return top + (bottom - top) * sy
+        }
+
+        private fun at(x: Int, y: Int): Float =
+            grid[Math.floorMod(y, GRID) * GRID + Math.floorMod(x, GRID)]
+
+        fun fbm(x: Float, y: Float): Float {
+            var sum = 0f
+            var amp = 1f
+            var freq = 1.5f
+            var norm = 0f
+            repeat(3) {
+                sum += amp * value(x * freq, y * freq)
+                norm += amp
+                amp *= 0.5f
+                freq *= 2f
+            }
+            return sum / norm
+        }
+
+        companion object {
+            const val GRID = 64
+        }
+    }
+}
