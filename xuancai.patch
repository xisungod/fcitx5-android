+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android
+
+import android.app.Application
+import android.os.Bundle
+import android.os.Looper
+import android.speech.RecognitionSupport
+import android.speech.RecognizerIntent
+import android.speech.SpeechRecognizer
+import org.fcitx.fcitx5.android.input.voice.AndroidOfflineVoiceBackend
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Failure
+import org.junit.Assert.*
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.LooperMode
+import org.robolectric.shadows.ShadowSpeechRecognizer
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], application = Application::class)
+@LooperMode(LooperMode.Mode.PAUSED)
+class OfflineVoiceAndroidPolicyTest {
+    @Test fun onlinePendingAndDownloadableChineseNeverStartAudioOrDownloadAModel() {
+        val unsupported = listOf(
+            RecognitionSupport.Builder().addOnlineLanguage("zh-CN").build(),
+            RecognitionSupport.Builder().addPendingOnDeviceLanguage("zh-CN").build(),
+            RecognitionSupport.Builder().addSupportedOnDeviceLanguage("zh-CN").build()
+        )
+        for (support in unsupported) {
+            ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+            val engine = OfflineVoiceEngine(RuntimeEnvironment.getApplication()) {}
+            try {
+                engine.start()
+                val service = shadowOf(ShadowSpeechRecognizer.getLatestSpeechRecognizer())
+                assertNull(service.lastRecognizerIntent)
+                service.triggerSupportResult(support)
+                shadowOf(Looper.getMainLooper()).idle()
+                assertEquals(Failure.LanguageUnavailable, engine.state.failure)
+                assertNull(service.lastRecognizerIntent)
+                assertNull(service.latestModelDownloadIntent)
+                assertTrue(service.isDestroyed)
+            } finally {
+                engine.destroy()
+            }
+        }
+    }
+
+    @Test fun installedChineseStartsOnDeviceAndReturnsPreviewBeforeExplicitAcceptance() {
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+        val engine = OfflineVoiceEngine(RuntimeEnvironment.getApplication()) {}
+        try {
+            engine.start()
+            val service = shadowOf(ShadowSpeechRecognizer.getLatestSpeechRecognizer())
+            assertEquals(OfflineVoiceEngine.Phase.Checking, engine.state.phase)
+            assertNull(service.lastRecognizerIntent)
+            service.triggerSupportResult(RecognitionSupport.Builder()
+                .addInstalledOnDeviceLanguage("zh-CN").build())
+            shadowOf(Looper.getMainLooper()).idle()
+            assertEquals(OfflineVoiceEngine.Phase.Listening, engine.state.phase)
+            val request = requireNotNull(service.lastRecognizerIntent)
+            assertEquals("zh-CN", request.getStringExtra(RecognizerIntent.EXTRA_LANGUAGE))
+            assertTrue(request.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+            assertNull(service.latestModelDownloadIntent)
+            service.triggerOnReadyForSpeech(Bundle())
+            service.triggerOnPartialResults(Bundle().apply {
+                putStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION, arrayListOf("本地预览"))
+            })
+            assertEquals("本地预览", engine.state.text)
+            assertNull(engine.consumeFinal())
+            service.triggerOnResults(Bundle().apply {
+                putStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION, arrayListOf("本地识别完成。"))
+            })
+            assertEquals(OfflineVoiceEngine.Phase.Ready, engine.state.phase)
+            assertTrue(service.isDestroyed)
+            assertEquals("本地识别完成。", engine.consumeFinal())
+            assertNull(engine.consumeFinal())
+        } finally {
+            engine.destroy()
+        }
+    }
+
+    @Test fun failedSupportQueryNeverFallsThroughToListening() {
+        ShadowSpeechRecognizer.setIsOnDeviceRecognitionAvailable(true)
+        val engine = OfflineVoiceEngine(RuntimeEnvironment.getApplication()) {}
+        try {
+            engine.start()
+            val service = shadowOf(ShadowSpeechRecognizer.getLatestSpeechRecognizer())
+            service.triggerSupportError(SpeechRecognizer.ERROR_CANNOT_CHECK_SUPPORT)
+            shadowOf(Looper.getMainLooper()).idle()
+            assertEquals(Failure.ServiceError, engine.state.failure)
+            assertNull(service.lastRecognizerIntent)
+            assertNull(service.latestModelDownloadIntent)
+            assertTrue(service.isDestroyed)
+        } finally {
+            engine.destroy()
+        }
+    }
+
+    @Test fun requestStaysChineseAndOfflineWithOnlyOneFinalAlternative() {
+        val request = AndroidOfflineVoiceBackend.recognitionRequest()
+        assertEquals("zh-CN", request.getStringExtra(RecognizerIntent.EXTRA_LANGUAGE))
+        assertTrue(request.getBooleanExtra(RecognizerIntent.EXTRA_PREFER_OFFLINE, false))
+        assertTrue(request.getBooleanExtra(RecognizerIntent.EXTRA_PARTIAL_RESULTS, false))
+        assertEquals(1, request.getIntExtra(RecognizerIntent.EXTRA_MAX_RESULTS, 0))
+        assertEquals(RecognizerIntent.LANGUAGE_MODEL_FREE_FORM,
+            request.getStringExtra(RecognizerIntent.EXTRA_LANGUAGE_MODEL))
+    }
+
+    @Test fun onlyInstalledMainlandSimplifiedChineseMeetsTheModelRequirement() {
+        assertTrue(AndroidOfflineVoiceBackend.hasInstalledChineseModel(listOf("en-US", "zh-CN")))
+        assertTrue(AndroidOfflineVoiceBackend.hasInstalledChineseModel(listOf("zh-Hans-CN")))
+        assertTrue(AndroidOfflineVoiceBackend.hasInstalledChineseModel(listOf("zh_CN")))
+        assertFalse(AndroidOfflineVoiceBackend.hasInstalledChineseModel(emptyList()))
+        assertFalse(AndroidOfflineVoiceBackend.hasInstalledChineseModel(listOf("en-US")))
+        assertFalse(AndroidOfflineVoiceBackend.hasInstalledChineseModel(listOf("zh-TW", "zh-HK")))
+        assertFalse(AndroidOfflineVoiceBackend.hasInstalledChineseModel(listOf("zh-Hant-CN", "zh")))
+    }
+
+    @Test fun serviceNetworkErrorsRemainFailuresInsteadOfTriggeringOnlineRetry() {
+        assertEquals(Failure.NetworkUnavailable,
+            AndroidOfflineVoiceBackend.failureFor(SpeechRecognizer.ERROR_NETWORK))
+        assertEquals(Failure.NetworkUnavailable,
+            AndroidOfflineVoiceBackend.failureFor(SpeechRecognizer.ERROR_NETWORK_TIMEOUT))
+        assertEquals(Failure.LanguageUnavailable,
+            AndroidOfflineVoiceBackend.failureFor(SpeechRecognizer.ERROR_LANGUAGE_UNAVAILABLE))
+        assertEquals(Failure.ServiceError,
+            AndroidOfflineVoiceBackend.failureFor(SpeechRecognizer.ERROR_CANNOT_CHECK_SUPPORT))
+    }
+
+    @Test
+    @Config(sdk = [30])
+    fun olderAndroidIsUnavailableRatherThanUsingTheGenericRecognizer() {
+        assertEquals(OfflineVoiceEngine.Availability.AndroidTooOld,
+            OfflineVoiceEngine.availability(RuntimeEnvironment.getApplication()))
+    }
+}
diff --git a/app/src/test/java/org/fcitx/fcitx5/android/OfflineVoiceEngineTest.kt b/app/src/test/java/org/fcitx/fcitx5/android/OfflineVoiceEngineTest.kt
