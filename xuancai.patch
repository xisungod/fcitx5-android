+    @Test
+    fun releaseHasOneBoundedPeakAndAnInterruptedPeakStillSettles() {
+        var now = 0L
+        val depth = KeyPressDepth(clock = { now })
+        depth.pressed()
+        now = 74
+        val beforeBottom = depth.currentScale()
+        now = 75
+        depth.released()
+        val bottom = depth.currentScale()
+        assertTrue("Compression must slow down before reaching its bottom", abs(beforeBottom - bottom) < 0.001f)
+        now = 76
+        var previous = depth.currentScale()
+        assertTrue("Return must begin gently without a hard upward kick", abs(previous - bottom) < 0.001f)
+        for (elapsed in 5L..140L step 5) {
+            var beforePeak = Float.NaN
+            if (elapsed == 60L) {
+                now = 134
+                beforePeak = depth.currentScale()
+            }
+            now = 75 + elapsed
+            val value = depth.currentScale()
+            assertTrue("The release cannot amplify beyond its small single peak", value >= 0.72f && value <= 1.03f)
+            if (elapsed <= 60) {
+                assertTrue("The first release stage must rise without an inward wobble", value + 0.000001f >= previous)
+            } else {
+                assertTrue("After its peak the key must settle without a second rebound", value <= previous + 0.000001f)
+            }
+            if (elapsed == 60L) {
+                assertEquals(1.03f, value, 0.000001f)
+                assertTrue("The outward return must slow down before its peak", abs(value - beforePeak) < 0.001f)
+                now = 136
+                assertTrue("Settling must begin gently without snapping back from the peak", abs(depth.currentScale() - value) < 0.001f)
+            }
+            previous = value
+        }
+        assertEquals(1f, depth.currentScale(), 0f)
+        assertFalse(depth.isTransitioning())
+
+        now = 300
+        depth.pressed()
+        now = 375
+        depth.released()
+        now = 435
+        val peak = depth.currentScale()
+        assertEquals(1.03f, peak, 0.000001f)
+        depth.pressed()
+        assertEquals("Re-pressing at the peak must not jump", peak, depth.currentScale(), 0f)
+        depth.released()
+        assertEquals("An immediate UP must preserve that same displayed frame", peak, depth.currentScale(), 0f)
+        assertTrue("A re-press at the peak still drives a new squeeze and return", depth.isTransitioning())
+        now = 470
+        assertTrue("Re-pressing must move inward continuously from the old peak", depth.currentScale() > 0.72f && depth.currentScale() < peak)
+        now = 510
+        assertEquals(0.72f, depth.currentScale(), 0.000001f)
+        now = 570
+        assertEquals("The new touch gets one return after completing its squeeze", 1.03f, depth.currentScale(), 0.000001f)
+        now = 650
+        assertEquals(1f, depth.currentScale(), 0f)
+        assertFalse(depth.isTransitioning())
+    }
