+                    val value = maxOf(Color.red(pixel), Color.green(pixel), Color.blue(pixel))
+                    if (value < 30) continue
+                    energy += value
+                    radialEnergy += value * kotlin.math.hypot((x - 300).toDouble(), (y - 100).toDouble())
+                }
+                return if (energy > 0) radialEnergy / energy else 0.0
+            }
