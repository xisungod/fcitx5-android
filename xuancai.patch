@@ -0,0 +1,81 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.input.keyboard
+
+import android.os.SystemClock
+
+/** One bounded squeeze and return, independent of the key's touch rectangle. */
+internal class KeyPressDepth(private val clock: () -> Long = SystemClock::uptimeMillis) {
+    private var from = 1f
+    private var pressedAt = 0L
+    private var releasedAt = 0L
+    private var held = false
+    private var active = false
+
+    // These are design values fitted to the visible squeeze in the supplied video,
+    // not Samsung's internal timing. Finish a quick tap's squeeze before returning;
+    // this only schedules paint and never delays its input action.
+    private val pressedScale = 0.72f
+    private val pressDuration = 75L
+    private val releasePeak = 1.03f
+    private val riseDuration = 60L
+    private val settleDuration = 80L
+
+    fun currentScale(): Float = scaleAt(clock())
+
+    fun isTransitioning(): Boolean {
+        if (!active) return false
+        val now = clock()
+        return if (held) from != pressedScale && now < pressedAt + pressDuration
+        else now < releasedAt + riseDuration + settleDuration
+    }
+
+    fun pressed() {
+        if (held) return
+        val now = clock()
+        from = scaleAt(now)
+        pressedAt = now
+        held = true
+        active = true
+    }
+
+    fun released() {
+        if (!held) return
+        held = false
+        releasedAt = maxOf(clock(), pressedAt + pressDuration)
+    }
+
+    fun reset() {
+        held = false
+        active = false
+        from = 1f
+        pressedAt = 0L
+        releasedAt = 0L
+    }
+
+    private fun scaleAt(now: Long): Float {
+        if (!active) return 1f
+        val pressElapsed = (now - pressedAt).coerceAtLeast(0L)
+        if (pressElapsed < pressDuration) {
+            val t = pressElapsed.toFloat() / pressDuration.toFloat()
+            val squeeze = t * t * (3f - 2f * t)
+            return from + (pressedScale - from) * squeeze
+        }
+        if (held) return pressedScale
+        val elapsed = (now - releasedAt).coerceAtLeast(0L)
+        if (elapsed < riseDuration) {
+            val t = elapsed.toFloat() / riseDuration.toFloat()
+            // Both ends start at rest. The middle returns quickly, without the
+            // instantaneous launch velocity of a regular cubic ease-out.
+            val remaining = 1f - t * t
+            val squared = remaining * remaining
+            return pressedScale + (releasePeak - pressedScale) * (1f - squared * squared)
+        }
+        if (elapsed >= riseDuration + settleDuration) return 1f
+        val t = (elapsed - riseDuration).toFloat() / settleDuration.toFloat()
+        val settle = t * t * (3f - 2f * t)
+        return releasePeak + (1f - releasePeak) * settle
+    }
+}
