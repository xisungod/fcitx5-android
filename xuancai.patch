+            val trail = org.robolectric.util.ReflectionHelpers.getField<org.fcitx.fcitx5.android.input.keyboard.PressEffectTrail>(h.effect, "ripples")
+            for (i in 0 until trail.size) gains[trail[i].start] = trail[i].lightGain
+            var postStopPeak = 0
