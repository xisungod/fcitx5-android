+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N) AppPrefs.getInstance().syncToDeviceEncryptedStorage()
+        super.onStop()
+    }
+}
diff --git a/app/src/main/java/org/fcitx/fcitx5/android/ui/main/settings/theme/LightEffectSettingsUi.kt b/app/src/main/java/org/fcitx/fcitx5/android/ui/main/settings/theme/LightEffectSettingsUi.kt
