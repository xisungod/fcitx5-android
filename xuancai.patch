+++ b/app/src/main/java/org/fcitx/fcitx5/android/input/voice/OfflineVoiceEngine.kt
@@ -0,0 +1,210 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android.input.voice
+
+import android.content.Context
+
+/** One explicit dictation session. Results are previews until the caller accepts them. */
+internal class OfflineVoiceEngine(
+    private val factory: BackendFactory,
+    private val scheduler: Scheduler,
+    private val onState: (State) -> Unit
+) {
+    constructor(context: Context, onState: (State) -> Unit) : this(
+        AndroidOfflineVoiceBackend.Factory(context), AndroidVoiceScheduler(), onState
+    )
+
+    enum class Phase { Idle, Checking, Listening, Processing, Ready, Failed, Disposed }
+    enum class Availability { Available, AndroidTooOld, NoOnDeviceService }
+    enum class Failure {
+        Unavailable, LanguageUnavailable, PermissionDenied, NoSpeech, Busy,
+        NetworkUnavailable, ServiceError, Timeout
+    }
+    data class State(val phase: Phase, val text: String = "", val failure: Failure? = null)
+
+    interface BackendFactory {
+        fun availability(): Availability
+        fun create(listener: Listener): Backend
+    }
+    interface Backend {
+        /** null means the installed local model is usable; no download is permitted. */
+        fun checkSupport(callback: (Failure?) -> Unit)
+        fun start()
+        fun stop()
+        fun cancel()
+        fun destroy()
+    }
+    interface Listener {
+        fun onReady()
+        fun onPartial(text: String)
+        fun onFinal(text: String)
+        fun onEnd()
+        fun onError(failure: Failure)
+    }
+    fun interface Cancellation { fun cancel() }
+    fun interface Scheduler { fun after(delayMs: Long, action: () -> Unit): Cancellation }
+
+    var state: State = State(Phase.Idle)
+        private set
+    private var generation = 0L
+    private var backend: Backend? = null
+    private var timer: Cancellation? = null
+    private var recognitionStarted = false
+    private var readyReceived = false
+
+    fun start() {
+        if (state.phase == Phase.Disposed) return
+        release()
+        val token = generation
+        emit(State(Phase.Checking))
+        if (!active(token)) return
+        try {
+            if (factory.availability() != Availability.Available) {
+                fail(token, Failure.Unavailable)
+                return
+            }
+            val created = factory.create(object : Listener {
+                override fun onReady() {
+                    if (!recognizing(token) || readyReceived) return
+                    readyReceived = true
+                    if (state.phase == Phase.Listening) arm(token, MAX_LISTEN_MS)
+                }
+
+                override fun onPartial(text: String) {
+                    if (!recognizing(token) || text.isBlank()) return
+                    emit(state.copy(text = text))
+                }
+
+                override fun onFinal(text: String) {
+                    if (!recognizing(token)) return
+                    if (text.isBlank()) {
+                        fail(token, Failure.NoSpeech)
+                        return
+                    }
+                    release()
+                    emit(State(Phase.Ready, text))
+                }
+
+                override fun onEnd() {
+                    if (!recognizing(token) || state.phase == Phase.Processing) return
+                    emit(state.copy(phase = Phase.Processing))
+                    if (active(token)) arm(token, FINAL_RESULT_TIMEOUT_MS)
+                }
+
+                override fun onError(failure: Failure) {
+                    if (active(token)) fail(token, failure)
+                }
+            })
+            if (!active(token)) {
+                runCatching { created.cancel() }
+                runCatching { created.destroy() }
+                return
+            }
+            backend = created
+            arm(token, SUPPORT_TIMEOUT_MS)
+            created.checkSupport { failure ->
+                if (!active(token) || recognitionStarted) return@checkSupport
+                if (failure != null) {
+                    fail(token, failure)
+                } else {
+                    recognitionStarted = true
+                    emit(State(Phase.Listening))
+                    if (active(token)) {
+                        arm(token, START_TIMEOUT_MS)
+                        guarded(token) { created.start() }
+                    }
+                }
+            }
+        } catch (_: SecurityException) {
+            fail(token, Failure.PermissionDenied)
+        } catch (_: RuntimeException) {
+            fail(token, Failure.ServiceError)
+        }
+    }
+
+    fun stop() {
+        if (state.phase == Phase.Checking) {
+            cancel()
+            return
+        }
+        if (state.phase != Phase.Listening) return
+        val token = generation
+        emit(state.copy(phase = Phase.Processing))
+        if (active(token)) {
+            arm(token, FINAL_RESULT_TIMEOUT_MS)
+            guarded(token) { backend?.stop() }
+        }
+    }
+
+    fun cancel() {
+        if (state.phase == Phase.Disposed) return
+        release()
+        emit(State(Phase.Idle))
+    }
+
+    fun destroy() {
+        if (state.phase == Phase.Disposed) return
+        release()
+        emit(State(Phase.Disposed))
+    }
+
+    /** Consumes an explicitly accepted final result exactly once. Never submits text itself. */
+    fun consumeFinal(): String? {
+        if (state.phase != Phase.Ready) return null
+        val text = state.text
+        emit(State(Phase.Idle))
+        return text
+    }
+
+    private fun active(token: Long) = token == generation && state.phase != Phase.Disposed
+    private fun recognizing(token: Long) = active(token) && recognitionStarted &&
+        (state.phase == Phase.Listening || state.phase == Phase.Processing)
+
+    private fun guarded(token: Long, action: () -> Unit) {
+        try {
+            action()
+        } catch (_: SecurityException) {
+            fail(token, Failure.PermissionDenied)
+        } catch (_: RuntimeException) {
+            fail(token, Failure.ServiceError)
+        }
+    }
+
+    private fun arm(token: Long, delayMs: Long) {
+        timer?.cancel()
+        timer = scheduler.after(delayMs) { if (active(token)) fail(token, Failure.Timeout) }
+    }
+
+    private fun fail(token: Long, failure: Failure) {
+        if (!active(token)) return
+        release()
+        emit(State(Phase.Failed, failure = failure))
+    }
+
+    private fun release() {
+        // Invalidate before talking to the service: cancel/destroy can produce callbacks.
+        generation++
+        recognitionStarted = false
+        readyReceived = false
+        timer?.cancel()
+        timer = null
+        val previous = backend
+        backend = null
+        runCatching { previous?.cancel() }
+        runCatching { previous?.destroy() }
+    }
+
+    private fun emit(next: State) {
+        state = next
+        onState(next)
+    }
+
+    companion object {
+        const val LANGUAGE = "zh-CN"
+        const val SUPPORT_TIMEOUT_MS = 8_000L
+        const val START_TIMEOUT_MS = 10_000L
+        const val MAX_LISTEN_MS = 90_000L
+        const val FINAL_RESULT_TIMEOUT_MS = 10_000L
+
+        fun availability(context: Context): Availability = AndroidOfflineVoiceBackend.availability(context)
+    }
+}
