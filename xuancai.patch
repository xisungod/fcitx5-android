+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+package org.fcitx.fcitx5.android
+
+import android.app.Application
+import android.app.AlertDialog
+import android.os.Looper
+import android.view.View
+import android.view.ContextThemeWrapper
+import android.view.ViewGroup
+import android.widget.TextView
+import androidx.appcompat.app.AppCompatActivity
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceInputUi
+import org.junit.After
+import org.junit.Assert.*
+import org.junit.Before
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.Robolectric
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.android.controller.ActivityController
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.LooperMode
+
+@RunWith(RobolectricTestRunner::class)
+@Config(sdk = [33], application = Application::class, qualifiers = "zh-rCN")
+@LooperMode(LooperMode.Mode.PAUSED)
+class OfflineVoiceInputUiTest {
+    private lateinit var activity: ActivityController<AppCompatActivity>
+    private val shown = mutableListOf<OfflineVoiceInputUi>()
+
+    @Before fun prepare() {
+        activity = Robolectric.buildActivity(AppCompatActivity::class.java).also {
+            it.get().setTheme(R.style.Theme_FcitxAppTheme)
+        }.setup()
+    }
+
+    @After fun cleanUp() {
+        shown.forEach { it.dismiss() }
+        shadowOf(Looper.getMainLooper()).idle()
+        activity.pause().stop().destroy()
+    }
+
+    private class RecordingBackend(val listener: OfflineVoiceEngine.Listener) : OfflineVoiceEngine.Backend {
+        var stopCalls = 0
+        var cancelCalls = 0
+        var destroyCalls = 0
+        override fun checkSupport(callback: (OfflineVoiceEngine.Failure?) -> Unit) = callback(null)
+        override fun start() = listener.onReady()
+        override fun stop() { stopCalls++ }
+        override fun cancel() { cancelCalls++ }
+        override fun destroy() { destroyCalls++ }
+    }
+
+    private class Factory : OfflineVoiceEngine.BackendFactory {
+        val sessions = mutableListOf<RecordingBackend>()
+        override fun availability() = OfflineVoiceEngine.Availability.Available
+        override fun create(listener: OfflineVoiceEngine.Listener) = RecordingBackend(listener).also {
+            sessions.add(it)
+        }
+        val current get() = sessions.last()
+    }
+
+    private fun show(factory: Factory, insert: (String) -> Boolean): OfflineVoiceInputUi {
+        val ui = OfflineVoiceInputUi(ContextThemeWrapper(activity.get(), R.style.Theme_InputViewTheme), insert) { listener ->
+            OfflineVoiceEngine(factory,
+                OfflineVoiceEngine.Scheduler { _, _ -> OfflineVoiceEngine.Cancellation {} }, listener)
+        }
+        shown.add(ui)
+        // The production IME's showDialog hook owns disposal for Back/system dismissal.
+        ui.dialog.setOnDismissListener { ui.dispose() }
+        ui.dialog.show()
+        shadowOf(Looper.getMainLooper()).idle()
+        ui.start()
+        return ui
+    }
+
+    private fun texts(view: View): List<String> = buildList {
+        if (view is TextView) add(view.text.toString())
+        if (view is ViewGroup) for (i in 0 until view.childCount) addAll(texts(view.getChildAt(i)))
+    }
+
+    private fun visibleText(ui: OfflineVoiceInputUi) = texts(ui.dialog.window!!.decorView)
+    private fun insertButton(ui: OfflineVoiceInputUi) = ui.dialog.getButton(AlertDialog.BUTTON_POSITIVE)
+    private fun controlButton(ui: OfflineVoiceInputUi) = ui.dialog.getButton(AlertDialog.BUTTON_NEUTRAL)
+
+    @Test fun partialAndStoppedPendingResultsCannotReachTheEditor() {
+        val factory = Factory()
+        val inserted = mutableListOf<String>()
+        val ui = show(factory) { inserted.add(it); true }
+        factory.current.listener.onPartial("尚未确认的文字")
+        assertTrue(visibleText(ui).contains("尚未确认的文字"))
+        assertFalse(insertButton(ui).isEnabled)
+        insertButton(ui).performClick()
+        assertTrue(inserted.isEmpty())
+
+        controlButton(ui).performClick()
+        assertEquals(1, factory.current.stopCalls)
+        assertFalse(insertButton(ui).isEnabled)
+        assertFalse(controlButton(ui).isEnabled)
+        assertTrue(visibleText(ui).contains(activity.get().getString(R.string.offline_voice_processing)))
+        insertButton(ui).performClick()
+        assertTrue(inserted.isEmpty())
+        assertTrue(ui.dialog.isShowing)
+    }
+
+    @Test fun aFinalResultRequiresConfirmationAndIsInsertedExactlyOnce() {
+        val factory = Factory()
+        val inserted = mutableListOf<String>()
+        val ui = show(factory) { inserted.add(it); true }
+        val backend = factory.current
+        backend.listener.onFinal("今天的天气很好。")
+        assertTrue(inserted.isEmpty())
+        assertTrue(insertButton(ui).isEnabled)
+        assertTrue(visibleText(ui).contains("今天的天气很好。"))
+        insertButton(ui).performClick()
+        shadowOf(Looper.getMainLooper()).idle()
+        assertEquals(listOf("今天的天气很好。"), inserted)
+        assertFalse(ui.dialog.isShowing)
+
+        insertButton(ui).performClick()
+        backend.listener.onFinal("迟到的第二次结果")
+        assertEquals(listOf("今天的天气很好。"), inserted)
+        assertEquals(1, backend.destroyCalls)
+    }
+
+    @Test fun cancelReleasesRecognitionAndDropsLateResults() {
+        val factory = Factory()
+        val inserted = mutableListOf<String>()
+        val ui = show(factory) { inserted.add(it); true }
+        val backend = factory.current
+        backend.listener.onPartial("取消前的文字")
+        ui.dialog.getButton(AlertDialog.BUTTON_NEGATIVE).performClick()
+        shadowOf(Looper.getMainLooper()).idle()
+        assertFalse(ui.dialog.isShowing)
+        assertEquals(1, backend.cancelCalls)
+        assertEquals(1, backend.destroyCalls)
+        backend.listener.onPartial("迟到的预览")
+        backend.listener.onFinal("迟到的结果")
+        insertButton(ui).performClick()
+        assertTrue(inserted.isEmpty())
+        assertFalse(visibleText(ui).contains("取消前的文字"))
+        assertFalse(visibleText(ui).contains("迟到的预览"))
+    }
+
+    @Test fun externalDismissalDisposesTheSessionBeforeLateCallbacksCanInsert() {
+        val factory = Factory()
+        val inserted = mutableListOf<String>()
+        val ui = show(factory) { inserted.add(it); true }
+        val backend = factory.current
+        ui.dialog.dismiss()
+        shadowOf(Looper.getMainLooper()).idle()
+        backend.listener.onFinal("切换窗口后的结果")
+        insertButton(ui).performClick()
+        assertTrue(inserted.isEmpty())
+        assertEquals(1, backend.destroyCalls)
+    }
+
+    @Test fun changedEditorRejectsTheResultAndDisablesInsertionAndRetry() {
+        val factory = Factory()
+        val attempted = mutableListOf<String>()
+        val ui = show(factory) { attempted.add(it); false }
+        factory.current.listener.onFinal("不能送到另一个输入框")
+        insertButton(ui).performClick()
+        assertTrue(ui.dialog.isShowing)
+        assertEquals(listOf("不能送到另一个输入框"), attempted)
+        assertFalse(insertButton(ui).isEnabled)
+        assertFalse(controlButton(ui).isEnabled)
+        assertTrue(visibleText(ui).contains(activity.get().getString(R.string.offline_voice_editor_changed)))
+        assertFalse(visibleText(ui).contains("不能送到另一个输入框"))
+        insertButton(ui).performClick()
+        factory.current.listener.onFinal("迟到的替代结果")
+        assertEquals(1, attempted.size)
+        assertEquals(1, factory.sessions.size)
+    }
+
+    @Test fun retryClearsOldTextAndIgnoresThePreviousSessionsCallbacks() {
+        val factory = Factory()
+        val inserted = mutableListOf<String>()
+        val ui = show(factory) { inserted.add(it); true }
+        val first = factory.current
+        first.listener.onFinal("第一遍识别")
+        assertTrue(insertButton(ui).isEnabled)
+        controlButton(ui).performClick()
+        assertEquals(2, factory.sessions.size)
+        assertFalse(insertButton(ui).isEnabled)
+        assertFalse(visibleText(ui).contains("第一遍识别"))
+        first.listener.onFinal("旧会话的迟到结果")
+        assertFalse(visibleText(ui).contains("旧会话的迟到结果"))
+
+        val second = factory.current
+        second.listener.onPartial("第二遍尚未完成")
+        second.listener.onError(OfflineVoiceEngine.Failure.NoSpeech)
+        assertFalse(visibleText(ui).contains("第二遍尚未完成"))
+        controlButton(ui).performClick()
+        assertEquals(3, factory.sessions.size)
+        assertFalse(insertButton(ui).isEnabled)
+        factory.current.listener.onFinal("第三遍确认内容")
+        insertButton(ui).performClick()
+        assertEquals(listOf("第三遍确认内容"), inserted)
+    }
+}
