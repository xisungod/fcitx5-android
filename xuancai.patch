diff --git a/app/src/main/java/org/fcitx/fcitx5/android/input/candidates/horizontal/CandidatePageBuffer.kt b/app/src/main/java/org/fcitx/fcitx5/android/input/candidates/horizontal/CandidatePageBuffer.kt
