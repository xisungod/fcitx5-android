@@ -0,0 +1,124 @@
+/*
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ * SPDX-FileCopyrightText: Copyright 2026 Fcitx5 for Android Contributors
+ */
+package org.fcitx.fcitx5.android.input.voice
+
+import android.content.Context
+import android.app.AlertDialog
+import android.view.View
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.fcitx.fcitx5.android.R
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Failure
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.Phase
+import org.fcitx.fcitx5.android.input.voice.OfflineVoiceEngine.State
+import splitties.dimensions.dp
+
+/** A separate preview keeps provisional ASR results out of the target editor. */
+internal class OfflineVoiceInputUi(
+    private val context: Context,
+    private val onInsert: (String) -> Boolean,
+    private val engineFactory: ((State) -> Unit) -> OfflineVoiceEngine = { listener ->
+        OfflineVoiceEngine(context, listener)
+    }
+) {
+    private var disposed = false
+    private val status = TextView(context).apply {
+        textSize = 14f
+        accessibilityLiveRegion = View.ACCESSIBILITY_LIVE_REGION_POLITE
+    }
+    private val preview = TextView(context).apply {
+        textSize = 20f
+        setPadding(0, context.dp(12), 0, context.dp(12))
+    }
+    private val content = LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        setPadding(context.dp(24), context.dp(8), context.dp(24), 0)
+        addView(status)
+        addView(ScrollView(context).apply { addView(preview) },
+            LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, context.dp(160)))
+    }
+    val dialog: AlertDialog = AlertDialog.Builder(context)
+        .setTitle(R.string.offline_voice_title)
+        .setView(content)
+        .setPositiveButton(R.string.offline_voice_insert, null)
+        .setNeutralButton(R.string.offline_voice_stop, null)
+        .setNegativeButton(android.R.string.cancel, null)
+        .create()
+
+    private val engine by lazy { engineFactory(::render) }
+
+    init {
+        dialog.setCanceledOnTouchOutside(false)
+        dialog.setOnShowListener {
+            dialog.getButton(AlertDialog.BUTTON_NEGATIVE).setOnClickListener { dismiss() }
+            dialog.getButton(AlertDialog.BUTTON_NEUTRAL).setOnClickListener {
+                when (engine.state.phase) {
+                    Phase.Listening -> engine.stop()
+                    Phase.Failed, Phase.Ready, Phase.Idle -> engine.start()
+                    else -> Unit
+                }
+            }
+            dialog.getButton(AlertDialog.BUTTON_POSITIVE).setOnClickListener {
+                val result = engine.consumeFinal() ?: return@setOnClickListener
+                // The owner verifies the editor/session identity before any text is inserted.
+                if (onInsert(result)) dismiss()
+                else {
+                    preview.text = ""
+                    status.setText(R.string.offline_voice_editor_changed)
+                    dialog.getButton(AlertDialog.BUTTON_POSITIVE).isEnabled = false
+                    dialog.getButton(AlertDialog.BUTTON_NEUTRAL).isEnabled = false
+                }
+            }
+            render(engine.state)
+        }
+    }
+
+    fun start() {
+        if (!disposed && dialog.isShowing) engine.start()
+    }
+
+    private fun render(state: State) {
+        if (disposed) return
+        preview.text = state.text
+        status.setText(when (state.phase) {
+            Phase.Idle -> R.string.offline_voice_ready_to_start
+            Phase.Checking -> R.string.offline_voice_checking
+            Phase.Listening -> R.string.offline_voice_listening
+            Phase.Processing -> R.string.offline_voice_processing
+            Phase.Ready -> R.string.offline_voice_review
+            Phase.Disposed -> R.string.offline_voice_cancelled
+            Phase.Failed -> when (state.failure) {
+                Failure.Unavailable -> R.string.offline_voice_unavailable
+                Failure.LanguageUnavailable -> R.string.offline_voice_language_unavailable
+                Failure.PermissionDenied -> R.string.offline_voice_permission_denied
+                Failure.NoSpeech -> R.string.offline_voice_no_speech
+                Failure.Busy -> R.string.offline_voice_busy
+                Failure.NetworkUnavailable -> R.string.offline_voice_service_error
+                Failure.Timeout -> R.string.offline_voice_timeout
+                else -> R.string.offline_voice_service_error
+            }
+        })
+        if (!dialog.isShowing) return
+        dialog.getButton(AlertDialog.BUTTON_POSITIVE).isEnabled = state.phase == Phase.Ready
+        dialog.getButton(AlertDialog.BUTTON_NEUTRAL).apply {
+            setText(if (state.phase == Phase.Listening || state.phase == Phase.Processing || state.phase == Phase.Checking)
+                R.string.offline_voice_stop else R.string.offline_voice_retry)
+            isEnabled = state.phase in setOf(Phase.Listening, Phase.Ready, Phase.Failed, Phase.Idle)
+        }
+    }
+
+    fun dismiss() {
+        dispose()
+        dialog.dismiss()
+    }
+
+    fun dispose() {
+        if (disposed) return
+        disposed = true
+        engine.destroy()
+        preview.text = ""
+    }
+}
