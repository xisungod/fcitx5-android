+            val identities = java.util.Collections.newSetFromMap(java.util.IdentityHashMap<org.fcitx.fcitx5.android.input.keyboard.PressEffectTrail.Ripple, Boolean>())
+            var lastTime = 0L
+            repeat(80) { i ->
+                h.press(900 + i, 0, i * 150L)
+                h.render(i * 150L).recycle()
+                h.now += 50
