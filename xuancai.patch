+    @Before
+    fun prepareWithoutStartingTheNativeEngine() {
+        val instanceField = FcitxApplication::class.java.getDeclaredField("instance").apply {
+            isAccessible = true
+        }
+        priorAppInstance = instanceField.get(null) as? FcitxApplication
+        val application = RuntimeEnvironment.getApplication()
+        val uiApplication = FcitxApplication()
+        ReflectionHelpers.callInstanceMethod<Void>(uiApplication, "attachBaseContext",
+            ReflectionHelpers.ClassParameter.from(Context::class.java, application))
+        FcitxApplication::class.java.getDeclaredField("instance").apply {
+            isAccessible = true
+            set(null, uiApplication)
+        }
+        AppPrefs.init(application.getSharedPreferences("key-press-depth", Context.MODE_PRIVATE))
+    }
+
+    @After
+    fun restoreApplicationInstance() {
+        FcitxApplication::class.java.getDeclaredField("instance").apply {
+            isAccessible = true
+            set(null, priorAppInstance)
+        }
+    }
+
+    @Test
+    fun zeroAndTwentyMillisecondTapsFinishTheSqueezeBeforeTheirSingleReturn() {
+        for (upTime in longArrayOf(0L, 20L)) {
+            var now = 0L
+            val depth = KeyPressDepth(clock = { now })
+            depth.pressed()
+            assertEquals(1f, depth.currentScale(), 0f)
+            now = upTime
+            val partial = depth.currentScale()
+            depth.released()
+            assertEquals("UP must preserve the displayed squeeze frame", partial, depth.currentScale(), 0f)
+            assertTrue("A short tap still drives its unfinished squeeze", depth.isTransitioning())
+            now = 50
+            assertTrue("Releasing cannot truncate a quick tap's visible press", depth.currentScale() < partial)
+            now = 74
+            assertTrue("The squeeze must still be moving before its bottom", depth.currentScale() > 0.72f)
+            now = 75
+            assertEquals("Even a zero-length touch reaches the configured bottom", 0.72f, depth.currentScale(), 0.000001f)
+            now = 100
+            assertTrue(depth.currentScale() > 0.72f && depth.currentScale() < 1.03f)
+            depth.released()
+            now = 135
+            assertEquals("A duplicate UP cannot postpone the single return peak", 1.03f, depth.currentScale(), 0.000001f)
+            now = 180
+            assertTrue("The key settles smoothly after its peak", depth.currentScale() > 1f && depth.currentScale() < 1.03f)
+            now = 215
+            assertEquals("A short tap finishes at DOWN+75+60+80, independent of early UP", 1f, depth.currentScale(), 0f)
+            assertFalse(depth.isTransitioning())
