+    private fun longestRun(samples: List<VisibilityFrame>, condition: (VisibilityFrame) -> Boolean): Int {
+        var longest = 0
+        var current = 0
+        for (sample in samples) {
+            current = if (condition(sample)) current + 1 else 0
+            longest = maxOf(longest, current)
+        }
+        return longest
+    }
